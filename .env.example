# 운영 설정 예시. 이 파일을 .env 로 복사해 값을 입력하세요. (.env 는 웹루트 밖에 두고 버전관리에서 제외)

APP_ENV=production
APP_TZ=Asia/Seoul
# 메일 본문 링크 등에 사용하는 접속 URL
APP_URL=http://localhost:8080
# 서브 경로로 배포할 때만 설정 (예: /srms). 루트 배포는 비워둠
APP_BASE_PATH=

# SQLite DB 파일 (상대경로는 프로젝트 루트 기준)
DB_PATH=storage/db/srms.sqlite

# 언어: 기본 언어와 선택 가능한 언어 (ko, ja, en, zh)
DEFAULT_LANG=ko
ENABLED_LANGS=ko,ja,en,zh

# 인증 방식: LOCAL / SSO / BOTH (SSO 는 어댑터 구현 후 사용. app/Auth/AuthProviderInterface.php)
AUTH_MODE=LOCAL
# 단일 회사로만 쓸 때 회사코드를 적으면 로그인 화면에서 회사 선택이 사라지고 이 회사로만 로그인합니다(비우면 다중 회사)
SINGLE_COMPANY=
# 첨부/메일 파일/로그/백업의 기준 폴더(상대경로는 프로젝트 루트 기준). 웹루트 밖에 두세요
STORAGE_PATH=storage
# 백업 폴더(비우면 STORAGE_PATH/backup)와 보관일
BACKUP_PATH=
BACKUP_KEEP_DAYS=14
# 유휴 세션 만료(분)
SESSION_LIFETIME_MIN=30
# 리버스 프록시 뒤에서 X-Forwarded-Proto 를 신뢰할 때만 1
TRUST_PROXY=0

# 메일(SMTP) - 알림 단계에서 사용
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls / ssl / none
SMTP_SECURE=tls
MAIL_FROM=
MAIL_FROM_NAME=SRMS
# smtp / file(storage/mail 에 .eml 저장, 개발용) / off(발송 보류, 대기열에만 보관). 비우면 SMTP_HOST 가 있으면 smtp,
# 없으면 개발환경은 file, 운영(APP_ENV=production)은 off
MAIL_DRIVER=

# 알림: 단계 기한 임박 판단(영업일), 일정 변경 회신 기한(영업일). 주기 작업은 `php bin/cron.php` (1시간 주기 권장)
DUE_SOON_DAYS=1

# 목록 한 페이지 건수(5~200). 요청 목록 기본 20, 메일 발송 이력 기본 30. 비우면 기본값
LIST_PAGE_SIZE=
MAIL_LOG_PAGE_SIZE=
SCHEDULE_RESPONSE_DAYS=3
